<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NinjaTraderAutoLogin</AssemblyName>
    <RootNamespace>NinjaTraderAutoLogin</RootNamespace>
    <ApplicationIcon>..\..\assets\launch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Auto Login for NinjaTrader</AssemblyTitle>
    <Description>Local Windows helper for NinjaTrader sign-in.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <EmbeddedResource Include="..\..\assets\fonts\Vazir-Regular.ttf" LogicalName="NinjaTraderAutoLogin.Fonts.Vazir.Regular.ttf" />
    <EmbeddedResource Include="..\..\assets\fonts\Vazir-Bold.ttf" LogicalName="NinjaTraderAutoLogin.Fonts.Vazir.Bold.ttf" />
    <EmbeddedResource Include="..\..\assets\fonts\OFL.txt" LogicalName="NinjaTraderAutoLogin.Fonts.Vazir.OFL.txt" />
    <EmbeddedResource Include="..\..\assets\*.ico;..\..\assets\*.png" LogicalName="NinjaTraderAutoLogin.Images.%(Filename)%(Extension)" />
    <Content Include="..\..\assets\*.ico" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\OFL.txt" Link="licenses\Vazir-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
